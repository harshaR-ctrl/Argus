<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Argus Report — {{ meta.owner }}/{{ meta.repo_name }}</title>
    <meta name="description" content="Security scan report for {{ meta.owner }}/{{ meta.repo_name }} generated by Argus">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        /* ── Tokens ───────────────────────────────────────────── */
        :root {
            --bg:#000000; --surface:#0a0a0a; --surface-2:#141414; --border:#262626;
            --text:#f2f2f2; --text-muted:#9a9a9a;
            --accent:#CCFF00; --accent-hover:#D4FF33; --accent-fg:#000000; --accent-text:#B2DF00;
            --glow:rgba(204,255,0,.25);
            --sev-critical:#ff4d4d; --sev-high:#ff8c2e; --sev-medium:#ffd22e; --sev-low:#4da6ff; --sev-info:#9a9a9a;
            --grade-a:#CCFF00; --grade-b:#a3e635; --grade-c:#ffd22e; --grade-d:#ff8c2e; --grade-f:#ff4d4d;
            --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
            --radius: 8px;
            --radius-sm: 6px;
        }
        :root[data-theme="light"] {
            --bg:#ffffff; --surface:#f5f5f5; --surface-2:#ebebeb; --border:#d4d4d4;
            --text:#0a0a0a; --text-muted:#525252;
            --accent:#99CC00; --accent-hover:#7AA300; --accent-fg:#000000; --accent-text:#7AA300;
            --glow:rgba(153,204,0,.30);
            --sev-critical:#cf222e; --sev-high:#bc4c00; --sev-medium:#9a6700; --sev-low:#0969da; --sev-info:#525252;
        }

        /* ── Reset & Base ─────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html { font-size: 16px; }
        body {
            font-family: var(--font-sans);
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }
        a { color: var(--accent-text); text-decoration: none; }
        a:hover { text-decoration: underline; }
        code, pre { font-family: var(--font-mono); }

        /* ── Layout ───────────────────────────────────────────── */
        .container { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
        .section { padding: 48px 0; border-bottom: 1px solid var(--border); }

        /* ── Header ───────────────────────────────────────────── */
        .report-header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 32px 0;
        }
        .report-header h1 {
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }
        .report-header h1 .logo { color: var(--accent); }
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .meta-item { font-size: 14px; }
        .meta-label { color: var(--text-muted); display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px; }
        .meta-value { font-family: var(--font-mono); font-size: 14px; }
        .meta-value.copyable { cursor: pointer; }
        .meta-value.copyable:hover { color: var(--accent-text); }

        /* ── Score Card ───────────────────────────────────────── */
        .score-card {
            display: flex;
            align-items: center;
            gap: 32px;
            padding: 32px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            margin: 32px 0;
        }
        .grade-circle {
            width: 96px; height: 96px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: 700;
            font-family: var(--font-mono);
            flex-shrink: 0;
        }
        .grade-A { background: rgba(204,255,0,.15); color: var(--grade-a); border: 2px solid var(--grade-a); }
        .grade-B { background: rgba(163,230,53,.15); color: var(--grade-b); border: 2px solid var(--grade-b); }
        .grade-C { background: rgba(255,210,46,.15); color: var(--grade-c); border: 2px solid var(--grade-c); }
        .grade-D { background: rgba(255,140,46,.15); color: var(--grade-d); border: 2px solid var(--grade-d); }
        .grade-F { background: rgba(255,77,77,.15); color: var(--grade-f); border: 2px solid var(--grade-f); }
        .score-text { font-size: 20px; font-weight: 600; }
        .score-number { font-family: var(--font-mono); }
        .severity-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
        .sev-chip {
            font-family: var(--font-mono);
            font-size: 12px;
            font-weight: 500;
            padding: 4px 12px;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .sev-critical { background: rgba(255,77,77,.15); color: var(--sev-critical); border: 1px solid var(--sev-critical); }
        .sev-high { background: rgba(255,140,46,.15); color: var(--sev-high); border: 1px solid var(--sev-high); }
        .sev-medium { background: rgba(255,210,46,.1); color: var(--sev-medium); border: 1px solid rgba(255,210,46,.4); }
        .sev-low { background: rgba(77,166,255,.1); color: var(--sev-low); border: 1px solid rgba(77,166,255,.4); }
        .sev-info { background: transparent; color: var(--sev-info); border: 1px solid var(--border); }

        /* ── Charts ────────────────────────────────────────────── */
        .charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0; }
        .chart-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 24px;
        }
        .chart-box h3 { font-size: 14px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 16px; }
        .bar-chart { display: flex; flex-direction: column; gap: 8px; }
        .bar-row { display: flex; align-items: center; gap: 12px; }
        .bar-label { font-size: 12px; font-family: var(--font-mono); width: 70px; text-transform: uppercase; }
        .bar-track { flex: 1; height: 24px; background: var(--surface-2); border-radius: 4px; overflow: hidden; position: relative; }
        .bar-fill { height: 100%; border-radius: 4px; transition: width 0.6s ease; min-width: 2px; }
        .bar-count { font-size: 12px; font-family: var(--font-mono); width: 32px; text-align: right; }

        /* ── Tabs ──────────────────────────────────────────────── */
        .tabs { border-bottom: 1px solid var(--border); display: flex; gap: 0; margin-bottom: 24px; }
        .tab-btn {
            background: none; border: none; color: var(--text-muted);
            font-family: var(--font-sans); font-size: 14px; font-weight: 500;
            padding: 12px 20px; cursor: pointer;
            border-bottom: 2px solid transparent;
            transition: color 0.15s, border-color 0.15s;
        }
        .tab-btn:hover { color: var(--text); }
        .tab-btn.active { color: var(--accent-text); border-bottom-color: var(--accent); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* ── Findings Table ────────────────────────────────────── */
        .filter-bar {
            display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; align-items: center;
        }
        .filter-bar select, .filter-bar input {
            background: var(--surface-2); border: 1px solid var(--border);
            color: var(--text); font-family: var(--font-sans); font-size: 14px;
            padding: 8px 12px; border-radius: var(--radius-sm);
        }
        .filter-bar input { flex: 1; min-width: 200px; }
        .filter-bar input::placeholder { color: var(--text-muted); }

        .findings-table { width: 100%; border-collapse: collapse; }
        .findings-table th {
            text-align: left; font-size: 12px; text-transform: uppercase;
            letter-spacing: 0.05em; color: var(--text-muted);
            padding: 12px 16px; border-bottom: 1px solid var(--border);
            background: var(--surface);
            position: sticky; top: 0;
        }
        .findings-table td {
            padding: 12px 16px; border-bottom: 1px solid var(--border);
            font-size: 14px; vertical-align: top;
        }
        .findings-table tr:hover td { background: var(--surface-2); }
        .finding-row { cursor: pointer; }
        .finding-detail {
            display: none; background: var(--surface);
        }
        .finding-detail.open { display: table-row; }
        .finding-detail td { padding: 20px 16px; }
        .detail-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 16px;
        }
        .detail-section h4 {
            font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;
            color: var(--text-muted); margin-bottom: 8px;
        }
        .detail-section p, .detail-section pre {
            font-size: 14px; line-height: 1.6;
        }
        .snippet-block {
            background: var(--bg); border: 1px solid var(--border);
            border-radius: var(--radius-sm); padding: 12px 16px;
            overflow-x: auto; font-family: var(--font-mono); font-size: 13px;
            line-height: 1.5; white-space: pre;
        }
        .file-link { font-family: var(--font-mono); font-size: 13px; color: var(--accent-text); }
        .cwe-tag, .owasp-tag {
            display: inline-block; font-size: 11px; font-family: var(--font-mono);
            padding: 2px 8px; border-radius: var(--radius-sm);
            background: var(--surface-2); margin-right: 4px;
        }

        /* ── Dependencies Table ────────────────────────────────── */
        .dep-table { width: 100%; border-collapse: collapse; }
        .dep-table th {
            text-align: left; font-size: 12px; text-transform: uppercase;
            letter-spacing: 0.05em; color: var(--text-muted);
            padding: 12px 16px; border-bottom: 1px solid var(--border);
            background: var(--surface);
        }
        .dep-table td {
            padding: 10px 16px; border-bottom: 1px solid var(--border);
            font-size: 14px; font-family: var(--font-mono);
        }

        /* ── Secrets Section ───────────────────────────────────── */
        .secret-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px 20px;
            margin-bottom: 12px;
        }
        .secret-card .secret-value { font-family: var(--font-mono); color: var(--sev-high); }
        .rotate-warning {
            font-size: 13px; color: var(--sev-high);
            margin-top: 8px; font-weight: 500;
        }

        /* ── Metadata ──────────────────────────────────────────── */
        .metadata-grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 16px;
        }
        .metadata-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px 20px;
        }
        .metadata-card h4 {
            font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em;
            color: var(--text-muted); margin-bottom: 8px;
        }
        .metadata-card ul { list-style: none; }
        .metadata-card li { font-size: 14px; padding: 4px 0; font-family: var(--font-mono); }

        /* ── Footer ────────────────────────────────────────────── */
        .report-footer {
            padding: 32px 0; text-align: center;
            font-size: 13px; color: var(--text-muted);
            border-top: 1px solid var(--border);
        }
        .disclaimer {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 16px 20px;
            font-size: 13px; color: var(--text-muted);
            margin: 24px 0;
        }

        /* ── Theme Toggle ──────────────────────────────────────── */
        .theme-toggle {
            position: fixed; top: 16px; right: 16px;
            background: var(--surface); border: 1px solid var(--border);
            color: var(--text); font-size: 20px;
            width: 40px; height: 40px; border-radius: 50%;
            cursor: pointer; display: flex; align-items: center; justify-content: center;
            z-index: 100;
        }

        /* ── Responsive ────────────────────────────────────────── */
        @media (max-width: 768px) {
            .score-card { flex-direction: column; text-align: center; }
            .charts-row { grid-template-columns: 1fr; }
            .detail-grid { grid-template-columns: 1fr; }
            .meta-grid { grid-template-columns: 1fr 1fr; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { transition: none !important; animation: none !important; }
        }

        /* Print */
        @media print {
            .theme-toggle, .filter-bar { display: none; }
            body { background: white; color: black; }
            .finding-detail { display: table-row !important; }
        }
    </style>
</head>
<body>
    <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle theme">T</button>

    <!-- Header -->
    <header class="report-header">
        <div class="container">
            <h1>Argus Security Report</h1>
            <div class="meta-grid">
                <div class="meta-item">
                    <span class="meta-label">Repository</span>
                    <span class="meta-value">
                        <a href="{{ meta.repo_url }}" target="_blank" rel="noopener">{{ meta.owner }}/{{ meta.repo_name }}</a>
                    </span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Branch</span>
                    <span class="meta-value">{{ meta.branch or 'default' }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Commit</span>
                    <span class="meta-value copyable" onclick="navigator.clipboard.writeText('{{ meta.commit_sha }}')">{{ meta.commit_sha[:12] }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Scan Date</span>
                    <span class="meta-value">{{ meta.scan_date.strftime('%Y-%m-%d %H:%M UTC') }}</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Duration</span>
                    <span class="meta-value">{{ "%.1f"|format(meta.duration_seconds) }}s</span>
                </div>
                <div class="meta-item">
                    <span class="meta-label">Languages</span>
                    <span class="meta-value">{{ meta.languages[:5]|join(', ') or 'None detected' }}</span>
                </div>
            </div>
        </div>
    </header>

    <main class="container">
        <!-- Score Card -->
        <div class="score-card">
            <div class="grade-circle grade-{{ grade }}">{{ grade }}</div>
            <div>
                <div class="score-text">Risk Score: <span class="score-number">{{ risk_score }}/100</span></div>
                <div class="severity-chips">
                    {% if severity_counts.critical %}
                    <span class="sev-chip sev-critical">{{ severity_counts.critical }} Critical</span>
                    {% endif %}
                    {% if severity_counts.high %}
                    <span class="sev-chip sev-high">{{ severity_counts.high }} High</span>
                    {% endif %}
                    {% if severity_counts.medium %}
                    <span class="sev-chip sev-medium">{{ severity_counts.medium }} Medium</span>
                    {% endif %}
                    {% if severity_counts.low %}
                    <span class="sev-chip sev-low">{{ severity_counts.low }} Low</span>
                    {% endif %}
                    {% if severity_counts.info %}
                    <span class="sev-chip sev-info">{{ severity_counts.info }} Info</span>
                    {% endif %}
                </div>
                <p style="margin-top: 8px; font-size: 14px; color: var(--text-muted);">
                    {{ findings|length }} finding{{ 's' if findings|length != 1 }} across {{ meta.files_scanned }} files
                    {% if result.noise_findings_count %} ({{ result.noise_findings_count }} in test paths hidden){% endif %}
                </p>
            </div>
        </div>

        <!-- Severity Bar Chart -->
        <div class="charts-row">
            <div class="chart-box">
                <h3>Findings by Severity</h3>
                <div class="bar-chart">
                    {% set max_count = [severity_counts.critical, severity_counts.high, severity_counts.medium, severity_counts.low, severity_counts.info]|max or 1 %}
                    <div class="bar-row">
                        <span class="bar-label" style="color:var(--sev-critical)">Critical</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (severity_counts.critical/max_count*100)|int }}%; background:var(--sev-critical)"></div></div>
                        <span class="bar-count">{{ severity_counts.critical }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label" style="color:var(--sev-high)">High</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (severity_counts.high/max_count*100)|int }}%; background:var(--sev-high)"></div></div>
                        <span class="bar-count">{{ severity_counts.high }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label" style="color:var(--sev-medium)">Medium</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (severity_counts.medium/max_count*100)|int }}%; background:var(--sev-medium)"></div></div>
                        <span class="bar-count">{{ severity_counts.medium }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label" style="color:var(--sev-low)">Low</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (severity_counts.low/max_count*100)|int }}%; background:var(--sev-low)"></div></div>
                        <span class="bar-count">{{ severity_counts.low }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label" style="color:var(--sev-info)">Info</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (severity_counts.info/max_count*100)|int }}%; background:var(--sev-info)"></div></div>
                        <span class="bar-count">{{ severity_counts.info }}</span>
                    </div>
                </div>
            </div>
            <div class="chart-box">
                <h3>Findings by Category</h3>
                <div class="bar-chart">
                    {% set max_cat = [category_counts.sast, category_counts.secret, category_counts.dependency]|max or 1 %}
                    <div class="bar-row">
                        <span class="bar-label">SAST</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (category_counts.sast/max_cat*100)|int }}%; background:var(--accent)"></div></div>
                        <span class="bar-count">{{ category_counts.sast }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label">Secrets</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (category_counts.secret/max_cat*100)|int }}%; background:var(--sev-high)"></div></div>
                        <span class="bar-count">{{ category_counts.secret }}</span>
                    </div>
                    <div class="bar-row">
                        <span class="bar-label">Deps</span>
                        <div class="bar-track"><div class="bar-fill" style="width:{{ (category_counts.dependency/max_cat*100)|int }}%; background:var(--sev-medium)"></div></div>
                        <span class="bar-count">{{ category_counts.dependency }}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Top Priorities -->
        {% if top_priorities %}
        <div class="section">
            <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 16px;">Top Priorities</h2>
            <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 16px;">The most critical issues to fix first.</p>
            {% for f in top_priorities %}
            <div style="display: flex; align-items: flex-start; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border);">
                <span class="sev-chip sev-{{ f.severity.value }}">{{ f.severity.value|upper }}</span>
                <div>
                    <strong>{{ f.title }}</strong>
                    <span class="file-link" style="margin-left: 8px;">{{ f.file }}{% if f.line_start %}:{{ f.line_start }}{% endif %}</span>
                    {% for cwe in f.cwe %}<span class="cwe-tag">{{ cwe }}</span>{% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Findings Tabs -->
        <div class="section">
            <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 16px;">Detailed Findings</h2>

            <div class="tabs" role="tablist">
                <button class="tab-btn active" onclick="switchTab(event, 'tab-all')" role="tab">All ({{ findings|length }})</button>
                <button class="tab-btn" onclick="switchTab(event, 'tab-sast')" role="tab">SAST ({{ sast_findings|length }})</button>
                <button class="tab-btn" onclick="switchTab(event, 'tab-secrets')" role="tab">Secrets ({{ secret_findings|length }})</button>
                <button class="tab-btn" onclick="switchTab(event, 'tab-deps')" role="tab">Dependencies ({{ dependency_findings|length }})</button>
            </div>

            <!-- All Findings -->
            <div id="tab-all" class="tab-panel active">
                <div class="filter-bar">
                    <select id="filter-severity" onchange="filterFindings()">
                        <option value="">All Severities</option>
                        <option value="critical">Critical</option>
                        <option value="high">High</option>
                        <option value="medium">Medium</option>
                        <option value="low">Low</option>
                        <option value="info">Info</option>
                    </select>
                    <input type="text" id="filter-file" placeholder="Search by file name..." oninput="filterFindings()">
                </div>
                <table class="findings-table">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Severity</th>
                            <th>Title</th>
                            <th>File</th>
                            <th style="width: 100px;">CWE</th>
                            <th style="width: 80px;">Tool</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for f in findings %}
                        <tr class="finding-row" onclick="toggleDetail('detail-{{ loop.index }}')" data-severity="{{ f.severity.value }}" data-file="{{ f.file }}">
                            <td><span class="sev-chip sev-{{ f.severity.value }}">{{ f.severity.value|upper }}</span></td>
                            <td>{{ f.title }}</td>
                            <td class="file-link">{{ f.file }}{% if f.line_start %}:{{ f.line_start }}{% endif %}</td>
                            <td>{% for cwe in f.cwe %}<span class="cwe-tag">{{ cwe }}</span>{% endfor %}</td>
                            <td style="font-family: var(--font-mono); font-size: 12px;">{{ f.tool }}</td>
                        </tr>
                        <tr class="finding-detail" id="detail-{{ loop.index }}">
                            <td colspan="5">
                                <div class="detail-grid">
                                    <div class="detail-section">
                                        <h4>Description</h4>
                                        <p>{{ f.description }}</p>
                                        {% if f.snippet %}
                                        <h4 style="margin-top: 16px;">Code Snippet</h4>
                                        <div class="snippet-block">{{ f.snippet }}</div>
                                        {% endif %}
                                    </div>
                                    <div class="detail-section">
                                        <h4>Classification</h4>
                                        <p>
                                            {% for cwe in f.cwe %}<span class="cwe-tag">{{ cwe }}</span>{% endfor %}
                                            {% for owasp in f.owasp %}<span class="owasp-tag">{{ owasp }}</span>{% endfor %}
                                        </p>
                                        <h4 style="margin-top: 16px;">Remediation</h4>
                                        <p style="white-space: pre-line;">{{ f.remediation }}</p>
                                        {% if f.references %}
                                        <h4 style="margin-top: 16px;">References</h4>
                                        <ul style="list-style: none;">
                                            {% for ref in f.references %}
                                            <li><a href="{{ ref }}" target="_blank" rel="noopener">{{ ref }}</a></li>
                                            {% endfor %}
                                        </ul>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if not findings %}
                <p style="text-align: center; padding: 48px; color: var(--text-muted);">
                    No findings detected. The scan completed with tools: {{ meta.tools_used|join(', ') }}.
                </p>
                {% endif %}
            </div>

            <!-- SAST Tab -->
            <div id="tab-sast" class="tab-panel">
                {% if sast_findings %}
                <table class="findings-table">
                    <thead><tr><th style="width:100px">Severity</th><th>Title</th><th>File</th><th>CWE</th></tr></thead>
                    <tbody>
                    {% for f in sast_findings %}
                    <tr class="finding-row" onclick="toggleDetail('sast-detail-{{ loop.index }}')">
                        <td><span class="sev-chip sev-{{ f.severity.value }}">{{ f.severity.value|upper }}</span></td>
                        <td>{{ f.title }}</td>
                        <td class="file-link">{{ f.file }}{% if f.line_start %}:{{ f.line_start }}{% endif %}</td>
                        <td>{% for cwe in f.cwe %}<span class="cwe-tag">{{ cwe }}</span>{% endfor %}</td>
                    </tr>
                    <tr class="finding-detail" id="sast-detail-{{ loop.index }}"><td colspan="4">
                        <p>{{ f.description }}</p>
                        {% if f.snippet %}<div class="snippet-block" style="margin-top:12px">{{ f.snippet }}</div>{% endif %}
                        {% if f.remediation %}<h4 style="margin-top:12px">Remediation</h4><p style="white-space:pre-line">{{ f.remediation }}</p>{% endif %}
                    </td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% else %}<p style="text-align:center;padding:32px;color:var(--text-muted)">No SAST findings.</p>{% endif %}
            </div>

            <!-- Secrets Tab -->
            <div id="tab-secrets" class="tab-panel">
                {% if secret_findings %}
                {% for f in secret_findings %}
                <div class="secret-card">
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px">
                        <span class="sev-chip sev-{{ f.severity.value }}">{{ f.severity.value|upper }}</span>
                        <strong>{{ f.title }}</strong>
                        {% if f.likely_test_data %}<span class="sev-chip sev-info">LIKELY TEST DATA</span>{% endif %}
                    </div>
                    <span class="file-link">{{ f.file }}{% if f.line_start %}:{{ f.line_start }}{% endif %}</span>
                    <p style="margin-top:8px;font-size:14px">{{ f.description }}</p>
                    <p class="rotate-warning">If this is a real credential, rotate it immediately.</p>
                </div>
                {% endfor %}
                {% else %}<p style="text-align:center;padding:32px;color:var(--text-muted)">No secrets detected.</p>{% endif %}
            </div>

            <!-- Dependencies Tab -->
            <div id="tab-deps" class="tab-panel">
                {% if dependency_findings %}
                <table class="dep-table">
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Package</th>
                            <th>Installed</th>
                            <th>Fixed In</th>
                            <th>Advisory</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for f in dependency_findings %}
                        <tr>
                            <td><span class="sev-chip sev-{{ f.severity.value }}">{{ f.severity.value|upper }}</span></td>
                            <td>{{ f.package or 'unknown' }}</td>
                            <td>{{ f.installed_version or '—' }}</td>
                            <td>{{ f.fixed_version or 'No fix yet' }}</td>
                            <td>
                                {% for aid in f.advisory_ids[:3] %}
                                <span class="cwe-tag">{{ aid }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}<p style="text-align:center;padding:32px;color:var(--text-muted)">No vulnerable dependencies found.</p>{% endif %}
            </div>
        </div>

        <!-- Scan Metadata -->
        <div class="section">
            <h2 style="font-size: 20px; font-weight: 600; margin-bottom: 16px;">Scan Metadata</h2>
            <div class="metadata-grid">
                <div class="metadata-card">
                    <h4>Tools Used</h4>
                    <ul>
                        {% for tool in meta.tools_used %}
                        <li>{{ tool }}{% if tool in meta.tool_versions %} ({{ meta.tool_versions[tool] }}){% endif %}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% if meta.scanner_errors %}
                <div class="metadata-card">
                    <h4>Scanner Errors</h4>
                    <ul>
                        {% for err in meta.scanner_errors %}
                        <li style="color: var(--sev-high);">{{ err.scanner }}: {{ err.error }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
                {% if meta.skipped_paths %}
                <div class="metadata-card">
                    <h4>Skipped Paths</h4>
                    <ul>
                        {% for path in meta.skipped_paths[:20] %}
                        <li>{{ path }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Disclaimer -->
        <div class="disclaimer">
            <strong>Disclaimer:</strong> Argus is an automated scanner. Results may include false positives and do not
            guarantee that the repository is free of vulnerabilities. This report should be used as a starting point
            for a security review, not as a definitive assessment.
        </div>
    </main>

    <footer class="report-footer">
        <p>Generated by <strong style="color: var(--accent-text)">Argus</strong> · {{ generated_at[:10] }}</p>
    </footer>

    <script>
        // Theme toggle
        function toggleTheme() {
            const html = document.documentElement;
            const current = html.getAttribute('data-theme');
            html.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
        }

        // Tabs
        function switchTab(e, tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            e.target.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        // Finding detail toggle
        function toggleDetail(id) {
            const el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }

        // Filtering
        function filterFindings() {
            const severity = document.getElementById('filter-severity').value;
            const fileSearch = document.getElementById('filter-file').value.toLowerCase();
            document.querySelectorAll('#tab-all .finding-row').forEach(row => {
                const rowSev = row.getAttribute('data-severity');
                const rowFile = (row.getAttribute('data-file') || '').toLowerCase();
                const sevMatch = !severity || rowSev === severity;
                const fileMatch = !fileSearch || rowFile.includes(fileSearch);
                row.style.display = (sevMatch && fileMatch) ? '' : 'none';
                // Also hide the detail row
                const nextRow = row.nextElementSibling;
                if (nextRow && nextRow.classList.contains('finding-detail')) {
                    if (!(sevMatch && fileMatch)) {
                        nextRow.classList.remove('open');
                        nextRow.style.display = 'none';
                    } else {
                        nextRow.style.display = '';
                    }
                }
            });
        }
    </script>
</body>
</html>
