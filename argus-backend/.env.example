# Argus Configuration
# Copy this to .env and fill in values

# NVIDIA NIM API Key (for LLM-powered explanations)
NVIDIA_NIM_API_KEY=

# NVIDIA NIM Model (default: meta/llama-3.1-70b-instruct)
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# NVIDIA NIM Base URL
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Enable LLM explanations (true/false)
LLM_ENABLED=false

# Max findings to send to LLM per scan (to stay within rate limits)
LLM_MAX_FINDINGS=20

# Scan limits
MAX_REPO_SIZE_MB=200
MAX_FILE_COUNT=20000
CLONE_TIMEOUT_SECONDS=120
SCANNER_TIMEOUT_SECONDS=300
GLOBAL_TIMEOUT_SECONDS=600

# Report output directory
REPORTS_DIR=./reports

# Database
DATABASE_URL=sqlite:///./argus.db

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
